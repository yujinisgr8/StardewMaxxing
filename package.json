{
  "name": "stardewmaxxing",
  "version": "0.1.0",
  "description": "Stardew Valley income optimizer — local macOS desktop app",
  "author": "Yujin",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:data": "tsx scripts/build-data.ts",
    "build:icon": "node scripts/logo.mjs",
    "test": "tsx src/engine/compute.test.ts && tsx src/engine/routes.smoke.test.ts && tsx src/data/items.seed.test.ts",
    "verify": "tsc --noEmit && npm test",
    "package": "npm run build && cp package.json .pkgbak.json && electron-builder; ec=$?; [ -f .pkgbak.json ] && mv -f .pkgbak.json package.json; if [ $ec -ne 0 ]; then exit $ec; fi; node scripts/smoke-package.mjs",
    "package:check": "node scripts/smoke-package.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.yujin.stardewmaxxing",
    "productName": "StardewMaxxing",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    }
  }
}
